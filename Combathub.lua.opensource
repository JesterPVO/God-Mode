-- Combat Hub — Made by animica (Updated with ESP Boxes, Fly, Speed, Inf Jump)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer
local Remote = ReplicatedStorage:FindFirstChild("Systems") 
    and ReplicatedStorage.Systems:FindFirstChild("ActionsSystem") 
    and ReplicatedStorage.Systems.ActionsSystem:FindFirstChild("Network") 
    and ReplicatedStorage.Systems.ActionsSystem.Network:FindFirstChild("Attack")

local enabled = false
local autoKillEnabled = false
local espEnabled = false
local autoCollectEnabled = false
local infJumpEnabled = false
local flyEnabled = false
local speedEnabled = false
local speedMultiplier = 16 -- default walkspeed increment or custom value

-- Fly Variables
local flying = false
local flySpeed = 50
local controlKeys = {W = 0, S = 0, A = 0, D = 0, Q = 0, E = 0}
local bodyGyro, bodyVelocity

local function valid(c) 
    return c and c:FindFirstChild("Humanoid") and c:FindFirstChild("HumanoidRootPart") and c.Humanoid.Health > 0 
end

local function getAllTargets()
    local my = LocalPlayer.Character
    if not valid(my) then return {} end
    local pos = my.HumanoidRootPart.Position
    local targets = {}
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local t = p.Character
            if valid(t) then
                local d = (t.HumanoidRootPart.Position - pos).Magnitude
                if d <= 100 then
                    table.insert(targets, t)
                end
            end
        end
    end
    
    local entitiesFolder = workspace:FindFirstChild("Entities")
    if entitiesFolder then
        for _, e in ipairs(entitiesFolder:GetChildren()) do
            if valid(e) then
                local d = (e.HumanoidRootPart.Position - pos).Magnitude
                if d <= 100 then
                    table.insert(targets, e)
                end
            end
        end
    end

    return targets
end

local function blitz(targets)
    if not Remote then return end
    pcall(function()
        for _, t in ipairs(targets) do
            task.spawn(function()
                for i = 1, 25 do
                    Remote:InvokeServer(t, 1)
                    Remote:InvokeServer(t, 2)
                end
            end)
        end
    end)
end

local function GetUnanchoredParts()
    local Parts = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and not v.Anchored then
            table.insert(Parts, v)
        end
    end
    return Parts
end

local function GetRandomPlayer()
    local plrs = Players:GetPlayers()
    local plrsExcl = {}
    for _, v in ipairs(plrs) do
        if v ~= LocalPlayer then
            table.insert(plrsExcl, v)
        end
    end
    if #plrsExcl == 0 then return nil end
    return plrsExcl[math.random(1, #plrsExcl)]
end

local function autoCollectDrops()
    pcall(function()
        local myChar = LocalPlayer.Character
        if not valid(myChar) then return end
        local rootPart = myChar.HumanoidRootPart

        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local nameLower = obj.Name:lower()
                if nameLower:find("drop") or nameLower:find("coin") or nameLower:find("gem") or nameLower:find("chest") or nameLower:find("item") or nameLower:find("loot") then
                    obj.CFrame = rootPart.CFrame
                    obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end)
end

-- UI Setup
local sg = Instance.new("ScreenGui", game.CoreGui)
sg.Name = "CombatHubUI"
sg.ResetOnSpawn = false

local espHolder = Instance.new("Folder", sg)
espHolder.Name = "ESPFolder"

local activeDrawings = {}

local function createESPElement(character)
    if activeDrawings[character] then return end
    
    local box = Instance.new("Frame", espHolder)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Visible = false
    
    local outline = Instance.new("UIStroke", box)
    outline.Color = Color3.fromRGB(255, 50, 50)
    outline.Thickness = 1.5
    
    local healthBarBg = Instance.new("Frame", box)
    healthBarBg.Name = "HPBg"
    healthBarBg.Size = UDim2.new(0, 4, 1, 0)
    healthBarBg.Position = UDim2.new(0, -6, 0, 0)
    healthBarBg.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    healthBarBg.BorderSizePixel = 0
    
    local healthBar = Instance.new("Frame", healthBarBg)
    healthBar.Name = "HP"
    healthBar.Size = UDim2.new(1, 0, 1, 0)
    healthBar.BackgroundColor3 = Color3.fromRGB(80, 255, 80)
    healthBar.BorderSizePixel = 0
    
    activeDrawings[character] = {Box = box, HP = healthBar}
end

local function removeESPElement(character)
    if activeDrawings[character] then
        activeDrawings[character].Box:Destroy()
        activeDrawings[character] = nil
    end
end

