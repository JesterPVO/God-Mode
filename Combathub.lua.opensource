local function createToggle(name, yPos, callback)
    local toggleContainer = Instance.new("Frame", container)
    toggleContainer.Size = UDim2.new(1, -10, 0, 46)
    toggleContainer.Position = UDim2.new(0, 5, 0, yPos)
    toggleContainer.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
    toggleContainer.BorderSizePixel = 0

    Instance.new("UICorner", toggleContainer).CornerRadius = UDim.new(0, 6)

    local toggleTitle = Instance.new("TextLabel", toggleContainer)
    toggleTitle.Size = UDim2.new(1, -60, 1, 0)
    toggleTitle.Position = UDim2.new(0, 12, 0, 0)
    toggleTitle.BackgroundTransparency = 1
    toggleTitle.Font = Enum.Font.GothamSemibold
    toggleTitle.Text = name
    toggleTitle.TextColor3 = Color3.fromRGB(220, 220, 225)
    toggleTitle.TextSize = 13
    toggleTitle.TextXAlignment = Enum.TextXAlignment.Left

    local toggleSwitch = Instance.new("TextButton", toggleContainer)
    toggleSwitch.Size = UDim2.new(0, 40, 0, 20)
    toggleSwitch.Position = UDim2.new(1, -50, 0.5, -10)
    toggleSwitch.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    toggleSwitch.BorderSizePixel = 0
    toggleSwitch.Text = ""

    Instance.new("UICorner", toggleSwitch).CornerRadius = UDim.new(0, 10)

    local toggleCircle = Instance.new("Frame", toggleSwitch)
    toggleCircle.Size = UDim2.new(0, 16, 0, 16)
    toggleCircle.Position = UDim2.new(0, 2, 0.5, -8)
    toggleCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    toggleCircle.BorderSizePixel = 0

    Instance.new("UICorner", toggleCircle).CornerRadius = UDim.new(1, 0)

    local function updateUI(state)
        if state then
            toggleSwitch.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
            toggleCircle:TweenPosition(UDim2.new(1, -18, 0.5, -8), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        else
            toggleSwitch.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            toggleCircle:TweenPosition(UDim2.new(0, 2, 0.5, -8), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.15, true)
        end
    end

    local function trigger()
        local newState = callback()
        updateUI(newState)
    end

    toggleContainer.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            trigger()
        end
    end)

    toggleSwitch.Activated:Connect(trigger)
end

-- Function to add slider controls for Speed
local function createSlider(name, yPos, min, max, default, callback)
    local sliderContainer = Instance.new("Frame", container)
    sliderContainer.Size = UDim2.new(1, -10, 0, 55)
    sliderContainer.Position = UDim2.new(0, 5, 0, yPos)
    sliderContainer.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
    sliderContainer.BorderSizePixel = 0

    Instance.new("UICorner", sliderContainer).CornerRadius = UDim.new(0, 6)

    local sliderTitle = Instance.new("TextLabel", sliderContainer)
    sliderTitle.Size = UDim2.new(1, -20, 0, 20)
    sliderTitle.Position = UDim2.new(0, 12, 0, 5)
    sliderTitle.BackgroundTransparency = 1
    sliderTitle.Font = Enum.Font.GothamSemibold
    sliderTitle.Text = name .. ": " .. default
    sliderTitle.TextColor3 = Color3.fromRGB(220, 220, 225)
    sliderTitle.TextSize = 13
    sliderTitle.TextXAlignment = Enum.TextXAlignment.Left

    local bgBar = Instance.new("Frame", sliderContainer)
    bgBar.Size = UDim2.new(1, -24, 0, 6)
    bgBar.Position = UDim2.new(0, 12, 0, 35)
    bgBar.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    bgBar.BorderSizePixel = 0

    Instance.new("UICorner", bgBar).CornerRadius = UDim.new(1, 0)

    local fillBar = Instance.new("Frame", bgBar)
    fillBar.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fillBar.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
    fillBar.BorderSizePixel = 0

    Instance.new("UICorner", fillBar).CornerRadius = UDim.new(1, 0)

    local dragging = false
    bgBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local pos = math.clamp((input.Position.X - bgBar.AbsolutePosition.X) / bgBar.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + ((max - min) * pos))
            fillBar.Size = UDim2.new(pos, 0, 1, 0)
            sliderTitle.Text = name .. ": " .. val
            callback(val)
        end
    end)
end

-- UI Components Creation
createToggle("God+ Killaura", 5, function()
    enabled = not enabled
    return enabled
end)

createToggle("AutoKill", 60, function()
    autoKillEnabled = not autoKillEnabled
    return autoKillEnabled
end)

createToggle("ESP & Health Bars", 115, function()
    espEnabled = not espEnabled
    if not espEnabled then
        for char, _ in pairs(activeDrawings) do
            removeESPElement(char)
        end
    end
    return espEnabled
end)

createToggle("Auto Collect Drops", 170, function()
    autoCollectEnabled = not autoCollectEnabled
    return autoCollectEnabled
end)

createToggle("Infinite Jump", 225, function()
    infJumpEnabled = not infJumpEnabled
    return infJumpEnabled
end)

createToggle("Fly (IE Style)", 280, function()
    flyEnabled = not flyEnabled
    flying = flyEnabled
    if flying then
        task.spawn(function()
            local char = LocalPlayer.Character
            if not valid(char) then return end
            local hrp = char.HumanoidRootPart
            
            bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Velocity = Vector3.new(0, 0, 0)
            bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bodyVelocity.Parent = hrp

            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            bodyGyro.CFrame = hrp.CFrame
            bodyGyro.Parent = hrp

            while flying and valid(LocalPlayer.Character) do
                local camCFrame = Camera.CFrame
                local moveDir = Vector3.new()
                if controlKeys.W == 1 then moveDir = moveDir + camCFrame.LookVector end
                if controlKeys.S == 1 then moveDir = moveDir - camCFrame.LookVector end
                if controlKeys.A == 1 then moveDir = moveDir - camCFrame.RightVector end
                if controlKeys.D == 1 then moveDir = moveDir + camCFrame.RightVector end
                if controlKeys.Q == 1 then moveDir = moveDir - Vector3.new(0, 1, 0) end
                if controlKeys.E == 1 then moveDir = moveDir + Vector3.new(0, 1, 0) end
                
                bodyVelocity.Velocity = moveDir * flySpeed
                bodyGyro.CFrame = camCFrame
                RunService.RenderStepped:Wait()
            end
            
            if bodyVelocity then bodyVelocity:Destroy() end
            if bodyGyro then bodyGyro:Destroy() end
        end)
    end
    return flyEnabled
end)

createSlider("Fly Speed", 335, 10, 200, 50, function(v)
    flySpeed = v
end)

createToggle("Speed Hack", 390, function()
    speedEnabled = not speedEnabled
    return speedEnabled
end)

-- Fly key inputs tracking
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if input.KeyCode == Enum.KeyCode.W then controlKeys.W = 1 end
        if input.KeyCode == Enum.KeyCode.S then controlKeys.S = 1 end
        if input.KeyCode == Enum.KeyCode.A then controlKeys.A = 1 end
        if input.KeyCode == Enum.KeyCode.D then controlKeys.D = 1 end
        if input.KeyCode == Enum.KeyCode.Space and infJumpEnabled then
            local char = LocalPlayer.Character
            if valid(char) then
                char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then controlKeys.W = 0 end
    if input.KeyCode == Enum.KeyCode.S then controlKeys.S = 0 end
    if input.KeyCode == Enum.KeyCode.A then controlKeys.A = 0 end
    if input.KeyCode == Enum.KeyCode.D then controlKeys.D = 0 end
end)

-- Unified Heartbeat Loop
RunService.Heartbeat:Connect(function()
    if enabled then
        local targets = getAllTargets()
        if #targets > 0 then
            blitz(targets)
        end
    end
    
    if autoKillEnabled then
        local unanchoredParts = GetUnanchoredParts()
        for _, part in ipairs(unanchoredParts) do
            part.AssemblyLinearVelocity = Vector3.new(0, -5, 0)
        end
        for _, part in ipairs(unanchoredParts) do
            local success, owner = pcall(function() return isnetworkowner(part) end)
            if success and owner then
                local targetPlayer = GetRandomPlayer()
                if targetPlayer and targetPlayer.Character and targetPlayer.Character.PrimaryPart then
                    part.CFrame = targetPlayer.Character.PrimaryPart.CFrame
                end
            end
        end
    end

    if autoCollectEnabled then
        autoCollectDrops()
    end

    if speedEnabled then
        local char = LocalPlayer.Character
        if valid(char) then
            char.Humanoid.WalkSpeed = 35 -- Custom modified speed
        end
    end

    if espEnabled then
        local currentTargets = getAllTargets()
        local tracked = {}

        for _, target in ipairs(currentTargets) do
            tracked[target] = true
            createESPElement(target)
            
            local drawing = activeDrawings[target]
            local rootPart = target:FindFirstChild("HumanoidRootPart")
            local humanoid = target:FindFirstChild("Humanoid")
            
            if rootPart and humanoid and drawing then
                local vector, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                if onScreen then
                    local sizeFactor = math.clamp(1000 / (Camera.CFrame.Position - rootPart.Position).Magnitude, 20, 400)
                    drawing.Box.Size = UDim2.new(0, sizeFactor * 0.6, 0, sizeFactor)
                    drawing.Box.Position = UDim2.new(0, vector.X - (sizeFactor * 0.3), 0, vector.Y - (sizeFactor * 0.5))
                    
                    local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                    drawing.HP.Size = UDim2.new(1, 0, healthPercent, 0)
                    drawing.HP.Position = UDim2.new(0, 0, 1 - healthPercent, 0)
                    drawing.HP.BackgroundColor3 = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
                    
                    drawing.Box.Visible = true
                else
                    drawing.Box.Visible = false
                end
            end
        end

        for char, _ in pairs(activeDrawings) do
            if not tracked[char] then
                removeESPElement(char)
            end
        end
    end
end)
