-- Joystick Logic
local function updateJoystick(input: InputObject)
    local center = JoystickBase.AbsolutePosition + (JoystickBase.AbsoluteSize / 2)
    local inputPos = Vector2.new(input.Position.X, input.Position.Y)
    local direction = inputPos - center
    local radius = JoystickBase.AbsoluteSize.X / 2
    
    if direction.Magnitude > radius then
        direction = direction.Unit * radius
    end
    
    JoystickStick.Position = UDim2.new(0.5, direction.X - 22, 0.5, direction.Y - 22)
    joystickVector = Vector3.new(direction.X / radius, 0, direction.Y / radius)
end

JoystickStick.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isJoystickDragging = true
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isJoystickDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateJoystick(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isJoystickDragging = false
        JoystickStick.Position = UDim2.new(0.5, -22, 0.5, -22)
        joystickVector = Vector3.new()
    end
end)

