-- Dragging Interface Logic
local function makeDraggable(frame: GuiObject)
    local dragging: boolean = false
    local dragInput: InputObject? = nil
    local dragStart: Vector3 = Vector3.new()
    local startPos: UDim2 = UDim2.new()
    
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

makeDraggable(MainFrame)
makeDraggable(UpdateMenuFrame)
makeDraggable(OpenBtn)
makeDraggable(OpenUpdatesBtn)

-- Slider Framework Handlers
local minSpeed, maxSpeed = 16, 150

-- Walkspeed Slider Logic
local isSliding = false
local function updateSlider(input: InputObject)
    local xOffset = math.clamp(input.Position.X - SliderFrame.AbsolutePosition.X, 0, SliderFrame.AbsoluteSize.X)
    local percentage = xOffset / SliderFrame.AbsoluteSize.X
    SliderBar.Size = UDim2.new(percentage, 0, 1, 0)
    TargetSpeed = math.round(minSpeed + (percentage * (maxSpeed - minSpeed)))
    SliderText.Text = "Speed Value: " .. tostring(TargetSpeed)
end

SliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isSliding = true
        updateSlider(input)
    end
end)

-- Fly Speed Slider Logic
local isSlidingFly = false
local function updateFlySlider(input: InputObject)
    local xOffset = math.clamp(input.Position.X - FlySliderFrame.AbsolutePosition.X, 0, FlySliderFrame.AbsoluteSize.X)
    local percentage = xOffset / FlySliderFrame.AbsoluteSize.X
    FlySliderBar.Size = UDim2.new(percentage, 0, 1, 0)
    FlySpeed = math.round(minSpeed + (percentage * (maxSpeed - minSpeed)))
    FlySliderText.Text = "Fly Speed: " .. tostring(FlySpeed)
end

FlySliderFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isSlidingFly = true
        updateFlySlider(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if isSliding then updateSlider(input) end
        if isSlidingFly then updateFlySlider(input) end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isSliding = false
        isSlidingFly = false
    end
end)

local function updateStatus()
    local parts = {}
    if auraEnabled then table.insert(parts, "Aura") end
    if speedEnabled then table.insert(parts, "Speed") end
    if flyEnabled then table.insert(parts, "Fly") end
    if autoEatEnabled then table.insert(parts, "Eat") end
    if espEnabled then table.insert(parts, "ESP") end
    if infJumpEnabled then table.insert(parts, "Jump") end
    
    if #parts > 0 then
        StatusText.Text = "ACTIVE: " .. table.concat(parts, " | ")
        StatusText.TextColor3 = Color3.fromRGB(0, 220, 120)
    else
        StatusText.Text = "SYSTEMS IDLE"
        StatusText.TextColor3 = Color3.fromRGB(220, 70, 70)
    end
end

-- Feature Toggles
local function toggleAura()
    auraEnabled = not auraEnabled
    ToggleBtn.BackgroundColor3 = auraEnabled and Color3.fromRGB(0, 130, 70) or Color3.fromRGB(30, 30, 30)
    ToggleBtn.Text = auraEnabled and "Disable GOD Kill Aura" or "Enable GOD Kill Aura"
    updateStatus()
end

local function toggleSpeed()
    speedEnabled = not speedEnabled
    SpeedBtn.BackgroundColor3 = speedEnabled and Color3.fromRGB(0, 130, 70) or Color3.fromRGB(30, 30, 30)
    SpeedBtn.Text = speedEnabled and "Disable WalkSpeed" or "Enable WalkSpeed"
    if not speedEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid") :: Humanoid?
        if hum then pcall(function() hum.WalkSpeed = 16 end) end
    end
    updateStatus()
end

local function toggleFly()
    flyEnabled = not flyEnabled
    FlyBtn.BackgroundColor3 = flyEnabled and Color3.fromRGB(0, 130, 70) or Color3.fromRGB(30, 30, 30)
    FlyBtn.Text = flyEnabled and "Disable Flight Mode" or "Enable Flight Mode"
    JoystickBase.Visible = flyEnabled and MainFrame.Visible
    updateStatus()
end

local function toggleEat()
    autoEatEnabled = not autoEatEnabled
    EatBtn.BackgroundColor3 = autoEatEnabled and Color3.fromRGB(0, 130, 70) or Color3.fromRGB(30, 30, 30)
    EatBtn.Text = autoEatEnabled and "Disable Auto-Eat" or "Enable Auto-Eat"
    updateStatus()
end

local function toggleESP()
    espEnabled = not espEnabled
    EspBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(0, 130, 70) or Color3.fromRGB(30, 30, 30)
    EspBtn.Text = espEnabled and "Disable Wallhack ESP" or "Enable Wallhack ESP"
    updateESPState()
    updateStatus()
end

local function toggleJump()
    infJumpEnabled = not infJumpEnabled
    JumpBtn.BackgroundColor3 = infJumpEnabled and Color3.fromRGB(0, 130, 70) or Color3.fromRGB(30, 30, 30)
    JumpBtn.Text = infJumpEnabled and "Disable Inf Jump" or "Enable Inf Jump"
    updateStatus()
end

UserInputService.JumpRequest:Connect(function()
    if infJumpEnabled and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid") :: Humanoid?
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- Main Cycle Runtime Framework Loop
RunService.Heartbeat:Connect(function(deltaTime)
    local now = os.clock()

    if LocalPlayer.Character and valid(LocalPlayer.Character) then
        local character = LocalPlayer.Character
        local hum = character:FindFirstChildOfClass("Humanoid") :: Humanoid?
        local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?

        if hrp and hum then
            -- Flight Pipeline Logic
            if flyEnabled then
                hum.PlatformStand = true
                local moveDir = hum.MoveDirection
                
                -- Support PC WASD input fallback blended with Mobile Joystick Vectors
                if joystickVector.Magnitude > 0 then
                    local camLook = Camera.CFrame.LookVector
                    local camRight = Camera.CFrame.RightVector
                    local flatLook = Vector3.new(camLook.X, 0, camLook.Z).Unit
                    local flatRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
                    moveDir = (flatLook * -joystickVector.Z) + (flatRight * joystickVector.X)
                end
                
                -- Check manual key triggers for vertical climb/descend configurations
                local verticalVelocity = 0
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                    verticalVelocity = 1
                elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
                    verticalVelocity = -1
                end
                
                local combinedDir = (moveDir + Vector3.new(0, verticalVelocity, 0))
                if combinedDir.Magnitude > 0 then
                    combinedDir = combinedDir.Unit
                end
                
                hrp.Velocity = combinedDir * FlySpeed
                hrp.Anchored = false
            else
                if hum.PlatformStand then
                    hum.PlatformStand = false
                end
                
                -- Regular WalkSpeed Execution Loop
                if speedEnabled and hum.WalkSpeed ~= TargetSpeed then
                    hum.WalkSpeed = TargetSpeed
                end
            end
        end
    end

    if auraEnabled and (now - lastAuraTick) > 0.12 then
        lastAuraTick = now
        local targets = getTargets()
        for _, t in ipairs(targets) do
            heavyHit(t)
        end
    end

    -- ITEM REMOTE CONSUME FRAMEWORK
    if autoEatEnabled and (now - lastEatTick) > 0.7 then
        local character = LocalPlayer.Character
        if character then
            local humanoid = character:FindFirstChildOfClass("Humanoid") :: Humanoid?
            if humanoid then
                local currentHealth = humanoid.Health
                local maxHealth = humanoid.MaxHealth
                
                local currentHunger: number = 100
                local hungerAttr = LocalPlayer:GetAttribute("Hunger") or LocalPlayer:GetAttribute("Food")
                if typeof(hungerAttr) == "number" then
                    currentHunger = hungerAttr
                else
                    local dataFolder = LocalPlayer:FindFirstChild("Data") :: Instance?
                    local hungerVal = dataFolder and dataFolder:FindFirstChild("Hunger") :: NumberValue?
                    if hungerVal and hungerVal:IsA("ValueBase") then
                        currentHunger = (hungerVal.Value :: any) or 100
                    end
                end

                if currentHealth < (maxHealth * 0.6) or currentHunger < 40 then
                    local foodName = findUsableFoodName()
                    
                    if foodName and UseRemote then
                        lastEatTick = now 
                        
                        task.spawn(function()
                            pcall(function()
                                if UseRemote:IsA("RemoteEvent") then
                                    UseRemote:FireServer(foodName)
                                    UseRemote:FireServer(foodName, 1) 
                                elseif UseRemote:IsA("RemoteFunction") then
                                    (UseRemote :: RemoteFunction):InvokeServer(foodName)
                                end
                            end)
                        end)
                    end
                end
            end
        end
    end
end)

-- Structural GC Disconnections
Players.PlayerRemoving:Connect(function(player)
    if player.Character then removeESP(player.Character) end
end)

ToggleBtn.MouseButton1Click:Connect(toggleAura)
SpeedBtn.MouseButton1Click:Connect(toggleSpeed)
FlyBtn.MouseButton1Click:Connect(toggleFly)
EatBtn.MouseButton1Click:Connect(toggleEat)
EspBtn.MouseButton1Click:Connect(toggleESP)
JumpBtn.MouseButton1Click:Connect(toggleJump)

-- Menu Display Handler (K Key)
UserInputService.InputBegan:Connect(function(i, gameProcessed)
    if gameProcessed then return end
    if i.KeyCode == Enum.KeyCode.K then
        sg.Enabled = not sg.Enabled
    end
end)

sg.Parent = targetGui
