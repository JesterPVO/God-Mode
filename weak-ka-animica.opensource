-- Remote References
local Systems = ReplicatedStorage:WaitForChild("Systems", 5) :: Instance?
local ActionsSystem = (Systems and Systems:WaitForChild("ActionsSystem", 5)) :: Instance?
local Network = (ActionsSystem and ActionsSystem:WaitForChild("Network", 5)) :: Instance?
local Remote = (Network and Network:WaitForChild("Attack", 5)) :: Instance?

-- Dynamic Remote Resolver for Item/Consumable Actions
local UseRemote = Network and (
    Network:FindFirstChild("UseItem") or 
    Network:FindFirstChild("Consume") or 
    Network:FindFirstChild("Eat") or 
    Network:FindFirstChild("Use") or 
    Network:FindFirstChild("InventoryAction")
) :: Instance?

local EntitiesFolder = workspace:FindFirstChild("Entities") :: Instance?

-- CONFIGURATION
local TargetSpeed: number = 50 
local FlySpeed: number = 50
local BURST_COUNT: number = 3 
local ATTACK_RANGE: number = 45

local auraEnabled: boolean = false
local speedEnabled: boolean = false
local flyEnabled: boolean = false
local autoEatEnabled: boolean = false
local espEnabled: boolean = false
local infJumpEnabled: boolean = false
local attackIndex: number = 1
local lastEatTick: number = 0
local lastAuraTick: number = 0

-- Joystick State Vectors
local joystickVector: Vector3 = Vector3.new()
local isJoystickDragging: boolean = false

local espObjects: { [Model]: Highlight } = {}

-- Validation Utilities
local function valid(c: Instance?): boolean
    if not c then return false end
    local hum = c:FindFirstChildOfClass("Humanoid") :: Humanoid?
    local hrp = c:FindFirstChild("HumanoidRootPart") :: BasePart?
    return (hum and hrp and hum.Health > 0) and true or false
end

-- Raycast obstruction check for safety
local function isVisible(targetPart: BasePart, origin: Vector3): boolean
    local character = LocalPlayer.Character
    if not character then return false end
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {character, targetPart.Parent}
    
    local result = workspace:Raycast(origin, targetPart.Position - origin, raycastParams)
    return result == nil
end

-- Target Filter
local function getTargets(): {Model}
    local my = LocalPlayer.Character
    if not valid(my) or not my then return {} end
    
    local myHrp = my:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not myHrp then return {} end
    local pos = myHrp.Position
    local targets: {Model} = {}
    
    local function evaluateEntity(e: Instance)
        if valid(e) and e:IsA("Model") then
            local hrp = e:FindFirstChild("HumanoidRootPart") :: BasePart?
            if hrp and (hrp.Position - pos).Magnitude <= ATTACK_RANGE then
                if isVisible(hrp, pos) then
                    table.insert(targets, e)
                end
            end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            evaluateEntity(p.Character)
        end
    end
    
    if EntitiesFolder then
        for _, e in ipairs(EntitiesFolder:GetChildren()) do
            evaluateEntity(e)
        end
    end
    return targets
end

-- Optimized Aura Burst
local function heavyHit(t: Model)
    if not Remote then return end
    local hrp = t:FindFirstChild("HumanoidRootPart") :: BasePart?
    if not hrp then return end
    
    for i = 1, BURST_COUNT do
        task.spawn(function()
            pcall(function()
                if Remote:IsA("RemoteEvent") then
                    Remote:FireServer(t, attackIndex)
                    Remote:FireServer(t, attackIndex, hrp.Position)
                elseif Remote:IsA("RemoteFunction") then
                    (Remote :: RemoteFunction):InvokeServer(t, attackIndex)
                end
            end)
        end)
    end
    attackIndex = (attackIndex == 1) and 2 or 1
end

-- Scans internal player folders/attributes for food name signatures
local function findUsableFoodName(): string?
    local backpack = LocalPlayer:FindFirstChild("Backpack") :: Instance?
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            local name = item.Name:lower()
            if name:find("apple") or name:find("stew") or name:find("bread") 
            or name:find("cooked") or name:find("meat") or name:find("steak") 
            or name:find("berry") or name:find("potion") or name:find("soup") then
                return item.Name
            end
        end
    end

    local invData = (LocalPlayer:FindFirstChild("Data") or LocalPlayer:FindFirstChild("Inventory") or LocalPlayer:FindFirstChild("Hotbar")) :: Instance?
    if invData then
        for _, item in ipairs(invData:GetChildren()) do
            local name = item.Name:lower()
            if name:find("apple") or name:find("stew") or name:find("bread") 
            or name:find("cooked") or name:find("meat") or name:find("steak") 
            or name:find("berry") or name:find("potion") or name:find("soup") then
                return item.Name
            end
        end
    end
    return nil
end

-- ==========================================
-- EVENT-DRIVEN ESP ENGINE
-- ==========================================
local function createESP(char: Model)
    if not espEnabled or espObjects[char] then return end
    
    local box = Instance.new("Highlight")
    box.Name = "SystemHighlight"
    box.Adornee = char
    box.FillColor = Color3.fromRGB(255, 60, 60)
    box.FillTransparency = 0.6
    box.OutlineColor = Color3.fromRGB(255, 255, 255)
    box.OutlineTransparency = 0.1
    box.Parent = char

    espObjects[char] = box
    
    local ancestryConn: RBXScriptConnection?
    ancestryConn = char.AncestryChanged:Connect(function()
        if not char:IsDescendantOf(workspace) then
            if espObjects[char] then
                espObjects[char]:Destroy()
                espObjects[char] = nil
            end
            if ancestryConn then
                ancestryConn:Disconnect()
            end
        end
    end)
end

local function removeESP(char: Model)
    if espObjects[char] then
        pcall(function() espObjects[char]:Destroy() end)
        espObjects[char] = nil
    end
end

local function cleanAllESP()
    for char, _ in pairs(espObjects) do
        removeESP(char)
    end
end

local function updateESPState()
    if not espEnabled then
        cleanAllESP()
        return
    end
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and valid(p.Character) then
            createESP(p.Character)
        end
    end
    if EntitiesFolder then
        for _, e in ipairs(EntitiesFolder:GetChildren()) do
            if valid(e) and e:IsA("Model") then createESP(e) end
        end
    end
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        if espEnabled and valid(char) then createESP(char) end
    end)
end)

if EntitiesFolder then
    EntitiesFolder.ChildAdded:Connect(function(child)
        task.wait(0.1)
        if espEnabled and valid(child) and child:IsA("Model") then createESP(child) end
    end)
end

task.spawn(function()
    while true do
        task.wait(1.5)
        if espEnabled then updateESPState() end
    end
end)

