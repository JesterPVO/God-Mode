b.Activated:Connect(toggleScript)

local wlFrame = Instance.new("Frame")
wlFrame.Size = UDim2.new(0, 150, 0, 200)
wlFrame.Position = UDim2.new(0.85, -160, 0.7, 0)
wlFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
wlFrame.BorderSizePixel = 0
wlFrame.Active = true
wlFrame.Draggable = true
wlFrame.Parent = sg
Instance.new("UICorner", wlFrame).CornerRadius = UDim.new(0, 8)

local wlTitle = Instance.new("TextLabel", wlFrame)
wlTitle.Size = UDim2.new(1, 0, 0, 25)
wlTitle.BackgroundTransparency = 1
wlTitle.Font = Enum.Font.GothamBold
wlTitle.Text = "KA WHITELIST"
wlTitle.TextColor3 = Color3.fromRGB(200, 200, 200)
wlTitle.TextSize = 12

local wlScroll = Instance.new("ScrollingFrame", wlFrame)
wlScroll.Size = UDim2.new(0.9, 0, 0.8, 0)
wlScroll.Position = UDim2.new(0.05, 0, 0.15, 0)
wlScroll.BackgroundTransparency = 1
wlScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
wlScroll.ScrollBarThickness = 3

local wlLayout = Instance.new("UIListLayout", wlScroll)
wlLayout.Padding = UDim.new(0, 4)

task.spawn(function()
    while true do
        for _, item in pairs(wlScroll:GetChildren()) do
            if item:IsA("TextButton") then item:Destroy() end
        end
        
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local pNameString = tostring(player.Name)
                
                if whitelistRegistry[pNameString] == nil then
                    whitelistRegistry[pNameString] = false
                end
                
                local pBtn = Instance.new("TextButton", wlScroll)
                pBtn.Size = UDim2.new(1, 0, 0, 22)
                pBtn.BorderSizePixel = 0
                pBtn.Font = Enum.Font.Gotham
                pBtn.Text = pNameString
                pBtn.TextSize = 11
                pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
                
                local function refreshVisual()
                    pBtn.BackgroundColor3 = whitelistRegistry[pNameString] and Color3.fromRGB(41, 128, 185) or Color3.fromRGB(50, 50, 50)
                end
                refreshVisual()
                
                pBtn.Activated:Connect(function()
                    whitelistRegistry[pNameString] = not whitelistRegistry[pNameString]
                    refreshVisual()
                end)
            end
        end
        wlScroll.CanvasSize = UDim2.new(0, 0, 0, wlLayout.AbsoluteContentSize.Y + 5)
        task.wait(10)
    end
end)

UserInputService.InputBegan:Connect(function(i, gameProcessed)
    if UserInputService:GetFocusedTextBox() then return end
    if i.KeyCode == Enum.KeyCode.K then
        toggleScript()
    end
end)
