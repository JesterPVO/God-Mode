f.Parent = sg

Instance.new("UICorner", f).CornerRadius = UDim.new(0, 12)

local b = Instance.new("TextButton", f)
b.Size = UDim2.new(0.8, 0, 0.8, 0)
b.Position = UDim2.new(0.1, 0, 0.1, 0)
b.BackgroundColor3 = Color3.fromRGB(200, 60, 60)
b.BorderSizePixel = 0
