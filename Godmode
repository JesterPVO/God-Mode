-- Function to create stylized buttons
local function createButton(name, text, bgColor, textColor, url)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.new(0, 175, 0, 40)
	btn.BackgroundColor3 = bgColor
	btn.Text = text
	btn.TextColor3 = textColor
	btn.TextSize = 14
	btn.Font = Enum.Font.GothamBold
	btn.BorderSizePixel = 0
	btn.Parent = buttonContainer
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = btn
	
	-- Open link functionality (Works in executors that support setclipboard / request or standard browser prompts)
	btn.MouseButton1Click:Connect(function()
		pcall(function()
			if setclipboard then
				setclipboard(url)
				print("Link copied to clipboard: " .. url)
			end
		end)
		-- Attempts to trigger standard browser prompt if supported by executor environment
		pcall(function()
			if syn and syn.request then
				syn.request({Url = "http://127.0.0.1:6463/rpc?v=1", Method = "POST"}) -- fallback behavior check
			end
		end)
	end)
	
	return btn
end

