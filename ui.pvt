if oldVoxel then oldVoxel:Destroy() end

-- Manage Signal Connections
if getgenv().AnimicaConns then
    for _, c in ipairs(getgenv().AnimicaConns) do
        if c then pcall(function() c:Disconnect() end) end
    end
end
local activeConns = {}
getgenv().AnimicaConns = activeConns

local function safeConnect(signal, func)
    local conn = signal:Connect(func)
    table.insert(activeConns, conn)
    return conn
end

