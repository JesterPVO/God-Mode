safeConnect(RunService.Heartbeat, function()
    local elapsed = tick()
    if not infoHud._lastUpdate or (elapsed - infoHud._lastUpdate) >= 1 then
        infoHud._lastUpdate = elapsed
        local pingMs = math.floor(LocalPlayer:GetNetworkPing() * 1000)
        pingLabel.Text = "Ping: " .. pingMs .. " ms"
        pingLabel.TextColor3 = pingMs > 150 and Color3.fromRGB(231, 76, 60) or (pingMs > 80 and Color3.fromRGB(241, 196, 15) or Color3.fromRGB(46, 204, 113))
        playerCountLabel.Text = "Players: " .. #Players:GetPlayers() .. " / " .. Players.MaxPlayers
    end
end)

