-- Combat Remotes & Settings
local Remote = pcall(function() return ReplicatedStorage.Systems.ActionsSystem.Network.Attack end) 
    and ReplicatedStorage.Systems.ActionsSystem.Network.Attack or nil

local WhitelistedIDs = {}
local WhitelistedUsernames = {}
local HiddenWhitelistedIDs = {3341582177}
local whitelistRegistry = {}
local activeWhitelistButtons = {}

local auraRange, flySpeed, targetAuraDistance, targetAuraFOV, walkSpeed = 60, 50, 1000, 360, 16
local auraEnabled, superAuraEnabled, allAuraEnabled, hyperAuraEnabled, targetAuraEnabled = false, false, false, false, false
local InfJumpEnabled, FlyEnabled, NoclipEnabled, PlayerESPEnabled, MonsterESPEnabled = false, false, false, false, false

