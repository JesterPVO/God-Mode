local function createPadBtn(text, pos, size, dir) 
    local b = Instance.new("TextButton") 
    b.Size = size; b.Position = pos; b.Text = text 
    b.BackgroundColor3 = Color3.fromRGB(70,70,75); b.TextColor3 = Color3.fromRGB(255,255,255) 
    b.Font = Enum.Font.SourceSansBold; b.TextSize = 13; b.Parent = DPadFrame 
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5) 
    b.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then moveDir = moveDir + dir end end) 
    b.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then moveDir = moveDir - dir end end) 
end 
createPadBtn("▲", UDim2.new(0.36, 0, 0.05, 0), UDim2.new(0, 35, 0, 35), Vector3.new(0, 0, -1)) 
createPadBtn("▼", UDim2.new(0.36, 0, 0.65, 0), UDim2.new(0, 35, 0, 35), Vector3.new(0, 0, 1)) 
createPadBtn("◀", UDim2.new(0.05, 0, 0.36, 0), UDim2.new(0, 35, 0, 35), Vector3.new(-1, 0, 0)) 
createPadBtn("▶", UDim2.new(0.65, 0, 0.36, 0), UDim2.new(0, 35, 0, 35), Vector3.new(1, 0, 0)) 
createPadBtn("UP", UDim2.new(0.36, 0, 0.36, 0), UDim2.new(0, 35, 0, 35), Vector3.new(0, 1, 0)) 
createPadBtn("DN", UDim2.new(0.05, 0, 0.75, 0), UDim2.new(0, 35, 0, 30), Vector3.new(0, -1, 0)) 

createSlider("Fly Speed", 10, 250, 50, 4, UniversalScroll, function(val) flySpeed = val end) 

FlyBtn.MouseButton1Click:Connect(function() 
    FlyEnabled = not FlyEnabled 
    FlyBtn.Text = "Fly: " .. (FlyEnabled and "ON" or "OFF") 
    FlyBtn.BackgroundColor3 = FlyEnabled and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(40, 40, 45) 
    DPadFrame.Visible = FlyEnabled 
    
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") 
    if FlyEnabled and root then 
        flyBodyGyro = Instance.new("BodyGyro", root); flyBodyGyro.P = 9e4; flyBodyGyro.maxTorque = Vector3.new(9e5, 9e5, 9e5); flyBodyGyro.cframe = root.CFrame 
        flyBodyVelocity = Instance.new("BodyVelocity", root); flyBodyVelocity.velocity = Vector3.new(0, 0.1, 0); flyBodyVelocity.maxForce = Vector3.new(9e5, 9e5, 9e5) 
        
        task.spawn(function() 
            while FlyEnabled and LocalPlayer.Character and flyBodyVelocity and flyBodyGyro do 
                local currentRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart") 
                if not currentRoot then break end 
                flyBodyGyro.Parent = currentRoot; flyBodyVelocity.Parent = currentRoot 
                local cameraCFrame = workspace.CurrentCamera.CFrame 
                local calculatedDir = Vector3.new(0,0,0) 
                
                if UIS:IsKeyDown(Enum.KeyCode.W) or moveDir.Z < 0 then calculatedDir = calculatedDir + cameraCFrame.LookVector end 
                if UIS:IsKeyDown(Enum.KeyCode.S) or moveDir.Z > 0 then calculatedDir = calculatedDir - cameraCFrame.LookVector end 
                if UIS:IsKeyDown(Enum.KeyCode.A) or moveDir.X < 0 then calculatedDir = calculatedDir - cameraCFrame.RightVector end 
                if UIS:IsKeyDown(Enum.KeyCode.D) or moveDir.X > 0 then calculatedDir = calculatedDir + cameraCFrame.RightVector end 
                if UIS:IsKeyDown(Enum.KeyCode.Space) or moveDir.Y > 0 then calculatedDir = calculatedDir + Vector3.new(0,1,0) end 
                if UIS:IsKeyDown(Enum.KeyCode.LeftShift) or moveDir.Y < 0 then calculatedDir = calculatedDir - Vector3.new(0,1,0) end 
                
                flyBodyGyro.cframe = cameraCFrame 
                flyBodyVelocity.velocity = calculatedDir.Magnitude > 0 and calculatedDir.Unit * flySpeed or Vector3.new(0,0,0) 
                RunService.RenderStepped:Wait() 
            end 
        end) 
    else 
        cleanupFly() 
    end 
end) 

-- Noclip
local NoclipBtn = createButton("Noclip: OFF", 5, UniversalScroll) 
NoclipBtn.MouseButton1Click:Connect(function() 
    NoclipEnabled = not NoclipEnabled 
    NoclipBtn.Text = "Noclip: " .. (NoclipEnabled and "ON" or "OFF") 
    NoclipBtn.BackgroundColor3 = NoclipEnabled and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(40, 40, 45) 
end) 
safeConnect(RunService.Stepped, function() 
    if NoclipEnabled and LocalPlayer.Character then 
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do 
            if part:IsA("BasePart") then part.CanCollide = false end 
        end 
    end 
end) 

-- Random Teleport
local TPBtn = createButton("⚡ Teleport to Random Player", 6, UniversalScroll) 
TPBtn.MouseButton1Click:Connect(function() 
    local targets = {} 
    for _, p in pairs(Players:GetPlayers()) do 
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then table.insert(targets, p) end 
    end 
    if #targets > 0 then 
        local randomPlayer = targets[math.random(1, #targets)] 
        LocalPlayer.Character.HumanoidRootPart.CFrame = randomPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 2, -3) 
        TPBtn.Text = "🎯 Teleported to " .. randomPlayer.DisplayName 
    else 
        TPBtn.Text = "❌ No targets found" 
    end 
    task.delay(1.5, function() TPBtn.Text = "⚡ Teleport to Random Player" end) 
end) 

-- Player Highlight ESP
local PlayerESPBtn = createButton("Player ESP: OFF", 7, UniversalScroll) 
local playerHighlights = {} 
local function applyPlayerESP(p) 
    if p == LocalPlayer then return end 
    safeConnect(p.CharacterAdded, function(char) 
        if PlayerESPEnabled then 
            local hl = Instance.new("Highlight", char) 
            hl.FillColor = Color3.fromRGB(52, 152, 219); hl.OutlineColor = Color3.fromRGB(255, 255, 255) 
            playerHighlights[p] = hl 
        end 
    end) 
    if p.Character and PlayerESPEnabled then 
        local hl = Instance.new("Highlight", p.Character) 
        hl.FillColor = Color3.fromRGB(52, 152, 219) 
        playerHighlights[p] = hl 
    end 
end 
PlayerESPBtn.MouseButton1Click:Connect(function() 
    PlayerESPEnabled = not PlayerESPEnabled 
    PlayerESPBtn.Text = "Player ESP: " .. (PlayerESPEnabled and "ON" or "OFF") 
    PlayerESPBtn.BackgroundColor3 = PlayerESPEnabled and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(40, 40, 45) 
    if PlayerESPEnabled then 
        for _, p in pairs(Players:GetPlayers()) do applyPlayerESP(p) end 
    else 
        for p, hl in pairs(playerHighlights) do if hl then hl:Destroy() end end 
        playerHighlights = {} 
    end 
end) 

-- Monster Tracer/Linker ESP
local MonsterESPBtn = createButton("Monster Linker ESP: OFF", 8, UniversalScroll) 
local activeLinks = {} 
MonsterESPBtn.MouseButton1Click:Connect(function() 
    MonsterESPEnabled = not MonsterESPEnabled 
    MonsterESPBtn.Text = "Monster Linker ESP: " .. (MonsterESPEnabled and "ON" or "OFF") 
    MonsterESPBtn.BackgroundColor3 = MonsterESPEnabled and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(40, 40, 45) 
    if not MonsterESPEnabled then 
        for _, adornment in pairs(activeLinks) do adornment:Destroy() end 
        activeLinks = {} 
    end 
end) 
safeConnect(RunService.RenderStepped, function() 
    if not MonsterESPEnabled or not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end 
    for _, adornment in pairs(activeLinks) do adornment:Destroy() end 
    activeLinks = {} 
    local myRoot = LocalPlayer.Character.HumanoidRootPart 
    for _, obj in pairs(workspace:GetDescendants()) do 
        if obj:IsA("Humanoid") and obj.Parent and obj.Parent:IsA("Model") and obj.Parent ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(obj.Parent) then 
            local enemyRoot = obj.Parent:FindFirstChild("HumanoidRootPart") or obj.Parent:FindFirstChild("Torso") 
            if enemyRoot then 
                local hl = Instance.new("BoxHandleAdornment") 
                hl.Size = enemyRoot.Parent:GetExtentsSize(); hl.AlwaysOnTop = true; hl.ZIndex = 5; hl.Color3 = Color3.fromRGB(231, 76, 60); hl.Adornee = enemyRoot; hl.Transparency = 0.5; hl.Parent = ScreenGui 
                table.insert(activeLinks, hl) 
                local line = Instance.new("LineHandleAdornment") 
                line.Length = (myRoot.Position - enemyRoot.Position).Magnitude; line.CFrame = CFrame.lookAt(myRoot.Position, enemyRoot.Position) 
                line.AlwaysOnTop = true; line.Thickness = 3; line.ZIndex = 4; line.Color3 = Color3.fromRGB(231, 76, 60); line.Adornee = myRoot; line.Parent = ScreenGui 
                table.insert(activeLinks, line) 
            end 
        end 
    end 
end) 

-- ==========================================
-- 8. TAB 2: COMBAT AURA & WHITELIST SYSTEM
-- ==========================================
local KillAuraBtn = createButton("Kill Aura: OFF [Key: R]", 1, VoxelScroll, Color3.fromRGB(200, 60, 60))
local HyperAuraBtn = createButton("Hyper Aura: OFF [Key: U]", 2, VoxelScroll, Color3.fromRGB(120, 20, 30))
local SuperAuraBtn = createButton("Super Aura: OFF [Key: Y]", 3, VoxelScroll, Color3.fromRGB(120, 80, 10))
local TargetAuraBtn = createButton("Target Aura: OFF [Key: V]", 4, VoxelScroll, Color3.fromRGB(40, 40, 45))
local AllAuraBtn = createButton("All-Target Aura: OFF", 5, VoxelScroll, Color3.fromRGB(90, 24, 130))

local function toggleAura()
    auraEnabled = not auraEnabled
    if auraEnabled then
        if hyperAuraEnabled then HyperAuraBtn.MouseButton1Click:Fire() end
        if superAuraEnabled then SuperAuraBtn.MouseButton1Click:Fire() end
        auraConn = safeConnect(RunService.Heartbeat, function() local t = nearest() if t then hit10(t) end updateAllESP() end)
    else
        if auraConn then auraConn:Disconnect() auraConn = nil end
    end
    KillAuraBtn.Text = "Kill Aura: " .. (auraEnabled and "ON [Key: R]" or "OFF [Key: R]")
    KillAuraBtn.BackgroundColor3 = auraEnabled and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(200, 60, 60)
    manageESP()
end

local function toggleHyperAura()
    hyperAuraEnabled = not hyperAuraEnabled
    if hyperAuraEnabled then
        if auraEnabled then toggleAura() end
        if superAuraEnabled then SuperAuraBtn.MouseButton1Click:Fire() end
        hyperAuraConn = safeConnect(RunService.Heartbeat, function() local t = nearest() if t then hit15(t) end updateAllESP() end)
    else
        if hyperAuraConn then hyperAuraConn:Disconnect() hyperAuraConn = nil end
    end
    HyperAuraBtn.Text = "Hyper Aura: " .. (hyperAuraEnabled and "ON [Key: U]" or "OFF [Key: U]")
    HyperAuraBtn.BackgroundColor3 = hyperAuraEnabled and Color3.fromRGB(231, 76, 60) or Color3.fromRGB(120, 20, 30)
    manageESP()
end

local function toggleSuperAura()
    superAuraEnabled = not superAuraEnabled
    if superAuraEnabled then
        if auraEnabled then toggleAura() end
        if hyperAuraEnabled then toggleHyperAura() end
        superAuraConn = safeConnect(RunService.Heartbeat, function() local t = getLookTarget() or nearest() if t then hit10(t) end updateAllESP() end)
    else
        if superAuraConn then superAuraConn:Disconnect() superAuraConn = nil end
    end
    SuperAuraBtn.Text = "Super Aura: " .. (superAuraEnabled and "ON [Key: Y]" or "OFF [Key: Y]")
    SuperAuraBtn.BackgroundColor3 = superAuraEnabled and Color3.fromRGB(241, 196, 15) or Color3.fromRGB(120, 80, 10)
    manageESP()
end

local function toggleTargetAura()
    targetAuraEnabled = not targetAuraEnabled
    if targetAuraEnabled then
        targetAuraConn = safeConnect(RunService.Heartbeat, function() local t = getLookTarget() if t then hit10(t) end updateAllESP() end)
    else
        if targetAuraConn then targetAuraConn:Disconnect() targetAuraConn = nil end
    end
    TargetAuraBtn.Text = "Target Aura: " .. (targetAuraEnabled and "ON [Key: V]" or "OFF [Key: V]")
    TargetAuraBtn.BackgroundColor3 = targetAuraEnabled and Color3.fromRGB(46, 204, 113) or Color3.fromRGB(40, 40, 45)
    manageESP()
end

local function toggleAllAura()
    allAuraEnabled = not allAuraEnabled
    if allAuraEnabled then
        allAuraConn = safeConnect(RunService.Heartbeat, function() local t = nearestAll() if t then hit10(t) end updateAllESP() end)
    else
        if allAuraConn then allAuraConn:Disconnect() allAuraConn = nil end
    end
    AllAuraBtn.Text = "All-Target Aura: " .. (allAuraEnabled and "ON" or "OFF")
    AllAuraBtn.BackgroundColor3 = allAuraEnabled and Color3.fromRGB(155, 89, 182) or Color3.fromRGB(90, 24, 130)
    manageESP()
end

KillAuraBtn.MouseButton1Click:Connect(toggleAura)
HyperAuraBtn.MouseButton1Click:Connect(toggleHyperAura)
SuperAuraBtn.MouseButton1Click:Connect(toggleSuperAura)
TargetAuraBtn.MouseButton1Click:Connect(toggleTargetAura)
AllAuraBtn.MouseButton1Click:Connect(toggleAllAura)

-- Keybindings
safeConnect(UIS.InputBegan, function(input, processed) 
    if UIS:GetFocusedTextBox() or processed then return end
    if input.KeyCode == Enum.KeyCode.R then toggleAura()
    elseif input.KeyCode == Enum.KeyCode.U then toggleHyperAura()
    elseif input.KeyCode == Enum.KeyCode.Y then toggleSuperAura()
    elseif input.KeyCode == Enum.KeyCode.V then toggleTargetAura()
    end 
end)

-- Range Configuration
createSlider("Aura Range", 5, 500, 60, 6, VoxelScroll, function(val) auraRange = val end)

-- Whitelist Header & Containers
local WlHeaderLabel = Instance.new("TextLabel")
WlHeaderLabel.Size = UDim2.new(0, 350, 0, 20); WlHeaderLabel.BackgroundTransparency = 1
WlHeaderLabel.Text = "--- PLAYER WHITELIST ---"; WlHeaderLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
WlHeaderLabel.Font = Enum.Font.SourceSansBold; WlHeaderLabel.TextSize = 14; WlHeaderLabel.LayoutOrder = 7
WlHeaderLabel.Parent = VoxelScroll

local WlContainer = Instance.new("Frame")
WlContainer.Size = UDim2.new(0, 350, 0, 120); WlContainer.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
WlContainer.BorderSizePixel = 0; WlContainer.LayoutOrder = 8; WlContainer.Parent = VoxelScroll
Instance.new("UICorner", WlContainer).CornerRadius = UDim.new(0, 6)

local WlScroll = Instance.new("ScrollingFrame")
WlScroll.Size = UDim2.new(1, -10, 1, -10); WlScroll.Position = UDim2.new(0, 5, 0, 5)
WlScroll.BackgroundTransparency = 1; WlScroll.BorderSizePixel = 0; WlScroll.ScrollBarThickness = 3
WlScroll.Parent = WlContainer

local WlListLayout = Instance.new("UIListLayout")
WlListLayout.Padding = UDim.new(0, 4); WlListLayout.Parent = WlScroll

local function updateWlCanvas()
    WlScroll.CanvasSize = UDim2.new(0, 0, 0, WlListLayout.AbsoluteContentSize.Y + 5)
end

local function addPlayerButton(player)
    if player == LocalPlayer or activeWhitelistButtons[player.UserId] then return end
    local pNameString = tostring(player.Name)
    if whitelistRegistry[pNameString] == nil then
        local isFriend = false
        pcall(function() isFriend = LocalPlayer:IsFriendsWith(player.UserId) end)
        whitelistRegistry[pNameString] = isFriend
    end
    
    local pBtn = Instance.new("TextButton")
    pBtn.Size = UDim2.new(1, 0, 0, 26); pBtn.BorderSizePixel = 0; pBtn.Font = Enum.Font.SourceSansBold
    local isFriendTag = ""
    pcall(function() if LocalPlayer:IsFriendsWith(player.UserId) then isFriendTag = " [FRIEND]" end end)
    pBtn.Text = pNameString .. isFriendTag
    pBtn.TextSize = 13; pBtn.TextColor3 = Color3.fromRGB(255, 255, 255); pBtn.Parent = WlScroll
    Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
    
    local function refreshVisual()
        pBtn.BackgroundColor3 = whitelistRegistry[pNameString] and Color3.fromRGB(41, 128, 185) or Color3.fromRGB(40, 40, 45)
    end
    refreshVisual()
    
    pBtn.MouseButton1Click:Connect(function()
        whitelistRegistry[pNameString] = not whitelistRegistry[pNameString]
        refreshVisual()
    end)
    
    activeWhitelistButtons[player.UserId] = pBtn
    updateWlCanvas()
end

local function removePlayerButton(player)
    if activeWhitelistButtons[player.UserId] then
        activeWhitelistButtons[player.UserId]:Destroy()
        activeWhitelistButtons[player.UserId] = nil
        updateWlCanvas()
    end
end

for _, p in pairs(Players:GetPlayers()) do addPlayerButton(p) end
safeConnect(Players.PlayerAdded, addPlayerButton)
safeConnect(Players.PlayerRemoving, removePlayerButton)
WlListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateWlCanvas)

-- Manual Whitelist Name Entry
local whitelistInputFrame = Instance.new("Frame")
whitelistInputFrame.Size = UDim2.new(0, 350, 0, 35); whitelistInputFrame.BackgroundTransparency = 1
whitelistInputFrame.LayoutOrder = 9; whitelistInputFrame.Parent = VoxelScroll

local boxBG = Instance.new("Frame")
boxBG.Size = UDim2.new(1, 0, 1, 0); boxBG.BackgroundColor3 = Color3.fromRGB(30, 30, 35); boxBG.Parent = whitelistInputFrame
Instance.new("UICorner", boxBG).CornerRadius = UDim.new(0, 6)

local WhitelistTextBox = Instance.new("TextBox")
WhitelistTextBox.Size = UDim2.new(1, -10, 1, 0); WhitelistTextBox.Position = UDim2.new(0, 5, 0, 0)
WhitelistTextBox.BackgroundTransparency = 1; WhitelistTextBox.Text = ""
WhitelistTextBox.PlaceholderText = "Add username manually + Press Enter..."
WhitelistTextBox.TextColor3 = Color3.fromRGB(255, 255, 255); WhitelistTextBox.PlaceholderColor3 = Color3.fromRGB(130, 130, 130)
WhitelistTextBox.Font = Enum.Font.SourceSans; WhitelistTextBox.TextSize = 13; WhitelistTextBox.Parent = boxBG

WhitelistTextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed and WhitelistTextBox.Text ~= "" then
        local nameToBlock = WhitelistTextBox.Text
        whitelistRegistry[nameToBlock] = true
        table.insert(WhitelistedUsernames, nameToBlock)
        WhitelistTextBox.Text = ""
        local originalColor = boxBG.BackgroundColor3
        boxBG.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        task.delay(1, function() boxBG.BackgroundColor3 = originalColor end)
    end
end)

