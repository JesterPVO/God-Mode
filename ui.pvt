playerCountLabel.Size = UDim2.new(1, -10, 0, 18); playerCountLabel.Position = UDim2.new(0, 8, 0, 20); playerCountLabel.Text = "Players: -- / --"
playerCountLabel.TextColor3 = Color3.fromRGB(180, 180, 180); playerCountLabel.BackgroundTransparency = 1; playerCountLabel.Font = Enum.Font.SourceSansBold
