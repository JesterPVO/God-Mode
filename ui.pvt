local oldGui = game:GetService("CoreGui"):FindFirstChild("AnimicaScriptsMenu") 
    or game:GetService("Players").LocalPlayer:FindFirstChildOfClass("PlayerGui"):FindFirstChild("AnimicaScriptsMenu") 
if oldGui then oldGui:Destroy() end 

